{
  "name": "screen-harbor",
  "productName": "Screen Harbor",
  "version": "1.0.9",
  "description": "Remote GNU Screen session manager",
  "author": "Screen Harbor",
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "smoke": "electron scripts/smoke.cjs",
    "test:terminal": "electron scripts/terminal-smoke.cjs",
    "format": "prettier --write src tests scripts *.json *.js *.ts index.html README.md"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "electron": "^42.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
